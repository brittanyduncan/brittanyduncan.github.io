	journal = {International Journal of Social Robotics},
	number = {6},
	pages = {1423--1434},
	title = {Design and Field Evaluation of a Mission Specialist Interface for Small Unmanned Aerial Systems},
	url = {https://doi.org/10.1007/s12369-022-00872-3},
