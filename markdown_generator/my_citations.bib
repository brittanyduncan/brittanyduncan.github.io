@inproceedings{duncan12b,
	abstract = {This article is the first known survey of the literature on the validation of autonomy in three key operations in Class I Unmanned Aerial Vehicles: take-off, landing, and GPS waypoint navigation and makes recommendations for consistent, informative experimentation. The eighteen studies which reported both indoor and outdoor experiments on take-off, landing, and GPS navigation yielded a surprising variety of experimental methods and each reported a different subset of 7 measures: 5 operating conditions (vehicle, size of vehicle, number of trials, wind, altitude of experiment), dependent variable (average error), and independent variable (basis of comparison). A comparison of studies to each other shows that experimental validation of basic UAS autonomous functions is incomplete, preventing replication of studies, and inconsistent, preventing direct comparison of algorithms. The resulting recommendations for experimental measures and methods are expected to be straightforward for designers and industry to implement and to allow researchers, program managers, and acquisition personnel to better, and more fairly, evaluate navigational autonomy.},
	author = {Duncan, B. A. and Murphy, R. R.},
	booktitle = {International Conference on Unmanned Aircraft Systems},
	date-modified = {2021-02-14 15:59:44 -0600},
	title = {Methods and Metrics of Autonomous Take-Off, Landing, and GPS Waypoint Navigation Experiments in Micro-UAVs},
	type = {Conference Proceedings},
	year = {2012}}

